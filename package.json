{
  "name": "brain_book",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch backend/src/server.ts\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx watch backend/src/server.ts",
    "db:setup": "tsx backend/src/db/setup.ts",
    "build": "tsc --noEmit && tsc --project backend/tsconfig.json && vite build",
    "start": "node dist-server/server.js",
    "lint": "tsc --noEmit && tsc --project backend/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.119.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "framer-motion": "^12.23.26",
    "helmet": "^8.3.0",
    "lucide-react": "^0.554.0",
    "pg": "^8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^8.3.8"
  }
}
