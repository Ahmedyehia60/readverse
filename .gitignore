# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies and package-manager caches
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Local caches and generated files
.cache/
.vite/
*.log
logs/
/coverage/

# build output
/dist/
/dist-server/
/out/
/build/

# Hosting provider metadata
/.vercel/
/.netlify/

# Local editor and operating-system files
.DS_Store
Thumbs.db
*.pem
.idea/
.agents/
backend/skills-lock.json

# Environment files contain credentials. Commit only sanitized examples.
.env*
!.env.example
!.env.*.example

# TypeScript build metadata
*.tsbuildinfo
